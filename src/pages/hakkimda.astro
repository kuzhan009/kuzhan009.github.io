---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

// Deneyim ve eğitim: en yenisi en üstte.
const experience = [
  {
    title: 'Üretim Mühendisi',
    place: 'Teknomelt Teknik Mensucat A.Ş.',
    period: 'Nisan 2026 – Günümüz',
    text: 'Üretim geliştirme ve süreç optimizasyonu üzerine çalışıyorum.',
  },
  {
    title: 'Mühendis',
    place: 'Balsu Mensucat A.Ş.',
    period: '',
    text: '',
  },
];
const education = [
  {
    title: 'Elektrik-Elektronik Mühendisliği',
    place: 'Süleyman Demirel Üniversitesi',
    period: '2016 – 2020',
    text: '',
  },
];
const skills = ['AutoCAD', 'Fusion 360', 'Python', 'PLC ve Otomasyon', 'Proteus'];
---
<Base title="Hakkımda" description={`${SITE.name} hakkında: deneyim, eğitim ve yetenekler.`}>
  <h1>Hakkımda</h1>
  <p class="role muted">{SITE.role}</p>
  <div class="prose">
    <p>
      Elektrik-elektronik mühendisiyim. Teknik tekstil sektöründe üretim mühendisi olarak
      üretim süreçlerini geliştirmek üzerine çalışıyorum.
    </p>
  </div>

  <h2>Deneyim</h2>
  <ul class="timeline">
    {experience.map((e) => (
      <li>
        <h3>{e.title}</h3>
        <div class="meta">{[e.place, e.period].filter(Boolean).join(' · ')}</div>
        {e.text && <p>{e.text}</p>}
      </li>
    ))}
  </ul>

  <h2>Eğitim</h2>
  <ul class="timeline">
    {education.map((e) => (
      <li>
        <h3>{e.title}</h3>
        <div class="meta">{[e.place, e.period].filter(Boolean).join(' · ')}</div>
        {e.text && <p>{e.text}</p>}
      </li>
    ))}
  </ul>

  <h2>Yetenekler</h2>
  <ul class="skills">{skills.map((s) => <li class="tag">{s}</li>)}</ul>

  <h2>İletişim</h2>
  <p>
    Bana <a href={`mailto:${SITE.email}`}>{SITE.email}</a> adresinden ulaşabilirsiniz.
    {SITE.social.map((s) => <> · <a href={s.url}>{s.label}</a></>)}
  </p>
</Base>
