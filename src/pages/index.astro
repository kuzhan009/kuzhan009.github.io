---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const projects = (await getCollection('projeler'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---
<Base>
  <section class="hero">
    <h1>{SITE.name}</h1>
    <p class="role">{SITE.role}</p>
    {SITE.intro && <p class="intro">{SITE.intro}</p>}
    <div class="buttons">
      <a class="btn primary" href="/hakkimda/">Hakkımda</a>
      <a class="btn" href={`mailto:${SITE.email}`}>İletişime geç</a>
    </div>
  </section>

  <div class="section-head">
    <h2>Son yazılar</h2>
    <a href="/blog/">Tümü →</a>
  </div>
  {posts.length > 0 ? (
    <ul class="list">
      {posts.map((p) => (
        <li><PostCard href={`/blog/${p.id}/`} {...p.data} /></li>
      ))}
    </ul>
  ) : <p class="empty">İlk yazılar yakında burada olacak.</p>}

  <div class="section-head">
    <h2>Öne çıkan projeler</h2>
    <a href="/projeler/">Tümü →</a>
  </div>
  {projects.length > 0 ? (
    <ul class="list grid-2">
      {projects.map((p) => (
        <li><PostCard href={`/projeler/${p.id}/`} {...p.data} /></li>
      ))}
    </ul>
  ) : <p class="empty">Projeler yakında burada olacak.</p>}
</Base>
