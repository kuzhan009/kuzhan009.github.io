---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Yazılar" description="İlgi duyduğum konular hakkında yazılar.">
  <h1>Yazılar</h1>
  <p class="muted">İlgi duyduğum konular hakkında düşüncelerim ve notlarım.</p>
  <ul class="list" style="margin-top:2rem">
    {posts.map((p) => (
      <li><PostCard href={`/blog/${p.id}/`} {...p.data} /></li>
    ))}
  </ul>
</Base>
